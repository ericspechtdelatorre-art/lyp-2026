{
  "name": "lenguajeikea",
  "version": "1.0.0",
  "description": "IKEALang IDE | KALLAX Studio — Escritorio",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "npx tsx test/test_ikealang.ts",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:3000 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:3000 electron .\"",
    "electron:build": "npm run build && electron-builder --win",
    "desktop": "npm run electron:dev"
  },
  "build": {
    "appId": "com.ikealang.kallaxstudio",
    "productName": "IKEALang IDE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/three": "^0.186.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.48.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wait-on": "^9.5.1"
  }
}
